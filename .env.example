# Next.js Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# SANITY CMS CONFIGURATION
# ===========================================

# Sanity Project ID and Dataset
NEXT_PUBLIC_SANITY_PROJECT_ID=u10im6di
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Token (for server-side queries with draft access)
# Create at: https://manage.sanity.io → Project → API → Tokens
SANITY_API_TOKEN=

# Preview secret - must match SANITY_STUDIO_PREVIEW_SECRET in Studio
SANITY_PREVIEW_SECRET=preview-secret-key

# Webhook secret for Sanity webhook verification
SANITY_WEBHOOK_SECRET=

# ===========================================
# WEBSITE URLS
# ===========================================

# Public URL of the website
# Development: http://localhost:3000
# Staging: https://stg.movingwalls.com
# Production: https://movingwalls.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# WEBSITE LEAD FORM → ZOHO CRM (server-side only)
# ===========================================
# Self client at https://api-console.zoho.com (scopes: ZohoCRM.modules.leads.CREATE,
# ZohoCRM.modules.attachments.CREATE). Leave the URLs empty for the US data centre.
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=
ZOHO_API_URL=
# Lead Assignment Rule id to apply to website leads (optional)
ZOHO_LEAD_RULE_ID=
# Signs the cookie that unlocks a visitor's one mock-up (any long random string)
MOCKUP_COOKIE_SECRET=
# Private tester link: /api/mockup/tester?key=<this> unlocks the mock-up on every site for that browser, no leads created. Open on localhost when unset.
MOCKUP_TESTER_KEY=

# Ad mock-up: stock photos and the photo/relevance checks
PEXELS_API_KEY=
ANTHROPIC_API_KEY=
